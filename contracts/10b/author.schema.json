{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milreu.example/schemas/proteus/author-10b.json",
  "title": "Proteus Author",
  "type": "object",
  "required": ["id", "preferredName", "nameVariants", "sources", "editorialStatus", "createdAt", "updatedAt"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "slug": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "preferredName": {"type": "string", "minLength": 1},
    "nameVariants": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "orcid": {"type": ["string", "null"], "pattern": "^0000-000[1-3]-[0-9]{4}-[0-9]{3}[0-9X]$"},
    "otherIdentifiers": {"type": "array", "items": {"type": "object", "required": ["scheme", "value"], "properties": {"scheme": {"type": "string"}, "value": {"type": "string"}}, "additionalProperties": false}},
    "affiliations": {"type": "array", "items": {"type": "object", "required": ["name", "source"], "properties": {"name": {"type": "string"}, "period": {"type": ["string", "null"]}, "source": {"type": "string"}}, "additionalProperties": false}},
    "publicBio": {"type": ["string", "null"], "maxLength": 1200},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["locator", "verifiedAt"], "properties": {"locator": {"type": "string"}, "verifiedAt": {"type": "string", "format": "date-time"}}, "additionalProperties": false}},
    "editorialStatus": {"enum": ["draft", "in_review", "published", "withdrawn", "rejected"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
