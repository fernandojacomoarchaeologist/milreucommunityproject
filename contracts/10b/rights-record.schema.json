{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milreu.example/schemas/proteus/rights-record-10b.json",
  "title": "Proteus Rights Record",
  "type": "object",
  "required": ["entityId", "accessStatus", "decisions", "evidence", "reviewedAt", "reviewedBy"],
  "properties": {
    "entityId": {"type": "string", "minLength": 1},
    "accessStatus": {"enum": ["open", "restricted", "metadata_only", "unknown"]},
    "licenseUri": {"type": ["string", "null"], "format": "uri"},
    "rightsStatementUri": {"type": ["string", "null"], "format": "uri"},
    "decisions": {
      "type": "object",
      "required": ["store", "process", "internalIndex", "quote", "publicSummarize", "redistribute", "train", "api", "mcp"],
      "properties": {
        "store": {"enum": ["allow", "deny", "unknown"]}, "process": {"enum": ["allow", "deny", "unknown"]}, "internalIndex": {"enum": ["allow", "deny", "unknown"]}, "quote": {"enum": ["allow", "deny", "unknown"]}, "publicSummarize": {"enum": ["allow", "deny", "unknown"]}, "redistribute": {"enum": ["allow", "deny", "unknown"]}, "train": {"enum": ["allow", "deny", "unknown"]}, "api": {"enum": ["allow", "deny", "unknown"]}, "mcp": {"enum": ["allow", "deny", "unknown"]}
      }, "additionalProperties": false
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "reviewedBy": {"type": "string", "minLength": 1},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
