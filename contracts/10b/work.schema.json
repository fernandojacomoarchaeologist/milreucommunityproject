{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milreu.example/schemas/proteus/work-10b.json",
  "title": "Proteus Work",
  "type": "object",
  "required": ["id", "title", "workType", "languages", "editorialStatus", "accessStatus", "sources", "createdAt", "updatedAt"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "slug": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": ["string", "null"]},
    "alternateTitles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "workType": {"enum": ["article", "book", "chapter", "report", "thesis", "dataset", "news", "other"]},
    "issued": {"type": ["object", "null"], "properties": {"value": {"type": "string"}, "precision": {"enum": ["day", "month", "year", "approximate", "unknown"]}}, "required": ["value", "precision"], "additionalProperties": false},
    "languages": {"type": "array", "items": {"type": "string", "minLength": 2}, "minItems": 1, "uniqueItems": true},
    "identifiers": {"type": "object", "properties": {"doi": {"type": ["string", "null"]}, "isbn": {"type": "array", "items": {"type": "string"}}, "issn": {"type": "array", "items": {"type": "string"}}, "urls": {"type": "array", "items": {"type": "string", "format": "uri"}}}, "additionalProperties": false},
    "publication": {"type": ["object", "null"]},
    "editorialStatus": {"enum": ["draft", "in_review", "published", "withdrawn", "rejected"]},
    "accessStatus": {"enum": ["open", "restricted", "metadata_only", "unknown"]},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind", "locator", "verifiedAt"], "properties": {"kind": {"type": "string"}, "locator": {"type": "string"}, "verifiedAt": {"type": "string", "format": "date-time"}}, "additionalProperties": false}},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "publishedAt": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
