{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milreu/contracts/10e/ingestion-proposal.schema.json",
  "title": "Lote de propostas de ingestão em quarentena (10E)",
  "description": "Entrada offline já preparada. Toda proposta permanece 'draft'. Copyright © 2026 Fernando Rodrigues de Jácomo — Projeto Comunitário de Milreu.",
  "type": "object",
  "additionalProperties": false,
  "required": ["batchId", "proposedBy", "proposedAt", "items"],
  "properties": {
    "batchId": { "type": "string", "minLength": 1 },
    "proposedBy": { "type": "string", "minLength": 1 },
    "proposedAt": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "language", "epistemicClass", "sourceId", "locator", "confidence", "proposedBy", "proposedAt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "enum": ["pt-PT", "en", "es", "fr"] },
          "epistemicClass": { "type": "string", "enum": ["fact_claim", "interpretation", "hypothesis", "memory_account", "inference", "uncertainty_statement"] },
          "status": { "type": "string", "const": "draft" },
          "sourceId": { "type": "string", "minLength": 1 },
          "sourceVersion": { "type": "string", "minLength": 1 },
          "entityIds": { "type": "array", "items": { "type": "string" } },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sourceId", "locatorType", "accessedAt"],
            "properties": {
              "id": { "type": "string" },
              "sourceId": { "type": "string" },
              "locatorType": { "type": "string", "enum": ["page", "page_range", "section", "figure", "table", "timestamp", "url_snapshot", "whole_resource"] },
              "pageStart": { "type": "integer", "minimum": 1 },
              "pageEnd": { "type": "integer", "minimum": 1 },
              "label": { "type": "string" },
              "url": { "type": "string" },
              "accessedAt": { "type": "string", "minLength": 1 },
              "quotation": { "type": "string" },
              "quotationRightsApproved": { "type": "boolean" },
              "notes": { "type": "string" }
            }
          },
          "transformation": { "type": "string" },
          "tool": { "type": "string" },
          "toolVersion": { "type": "string" },
          "aiAssisted": { "type": "boolean" },
          "hash": { "type": "string" },
          "quotation": { "type": "string" },
          "quotationRightsApproved": { "type": "boolean" },
          "confidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "reasons"],
            "properties": {
              "level": { "type": "string", "enum": ["insufficient", "limited", "supported", "well_supported"] },
              "reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          },
          "proposedBy": { "type": "string", "minLength": 1 },
          "proposedAt": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
